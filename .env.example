# ====================================================================
# FinMaster - Configuração de Ambiente & Conexões
# ====================================================================
# Você pode configurar estas variáveis no arquivo .env OU diretamente
# na interface web em "Configurações" > "Conexão Supabase / IA / OKX".

# 1. Supabase (Banco de Dados & Autenticação)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# 2. Provedor de IA (Opcional - Pode ser configurado via UI de Configurações)
# Provedores suportados: Google Gemini, Groq, OpenAI, OpenRouter
VITE_AI_PROVIDER=gemini
VITE_AI_API_KEY=your-gemini-or-openai-api-key

# 3. OKX Exchange CEX (Opcional - Sincronização de Criptoativos)
# Pode ser configurado diretamente na aba de Configurações do usuário.
OKX_API_KEY=your-okx-api-key
OKX_SECRET_KEY=your-okx-secret-key
OKX_PASSPHRASE=your-okx-passphrase
