{
  "name": "finmaster",
  "version": "1.4.0",
  "license": "MIT",
  "author": "Luca Rodrigues Gomes de Sant'Anna <lucasantannaeng@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --win",
    "android:sync": "vite build && cap sync android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
